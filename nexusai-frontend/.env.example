# Copy this file to .env and adjust for your environment.
VITE_API_URL=http://localhost:5000/api

# ── Firebase (Google sign-in) ───────────────────────────────────
# From your Firebase project's web app config (Project Settings -> General
# -> Your apps -> SDK setup and configuration). Leave blank to run without
# Google sign-in — the button hides itself if these aren't set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
