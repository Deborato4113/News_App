# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already gitignored.

NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>

# Groq API key — https://console.groq.com
GROQ_API_KEY=

# NewsAPI key — https://newsapi.org
NEWS_API_KEY=

# Long, random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Optional: pino log level (trace|debug|info|warn|error|fatal)
LOG_LEVEL=debug

# ── Firebase (Google sign-in) ───────────────────────────────────
# From your Firebase project's service account (Project Settings ->
# Service Accounts -> Generate new private key -> downloads a JSON file).
# Google sign-in returns a clean 503 to the frontend if these are left
# blank, so the rest of the app works fine without them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the JSON file's "private_key" value here, keeping the \n sequences
# literal (don't convert them to real newlines in the .env file).
FIREBASE_PRIVATE_KEY=

# ── SMTP (password reset emails) ────────────────────────────────
# Optional in development — if left blank, reset links are logged to the
# server console instead of emailed, so the flow still works for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexusai.example
